{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=secure_vault;Username=secure;Password=secure"
  },
  "Vault": {
    "Url": "http://localhost:8200",
    "Token": "root",
    "KeyName": "tokenizer"
